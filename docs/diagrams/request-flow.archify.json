  "cards": [
    {
      "dot": "rose",
      "title": "Block fails loud",
      "items": [
        "A blocked category stops the whole request before the model is called",
        "The error and the audit row name the category, never the value"
      ]
    },
    {
      "dot": "emerald",
      "title": "Never guess",
      "items": [
        "Only exact placeholders are restored",
        "A damaged placeholder stays as written and comes back as a warning"
      ]
    },
    {
      "dot": "violet",
      "title": "One vault per request",
      "items": [
        "Placeholders are stable within a request, so the model can tell who is who",
        "The vault hides its values from console.log and JSON"
      ]
    }
